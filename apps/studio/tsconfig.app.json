{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@jack-tan/studio-core": ["../../packages/studio-core/src/index.ts"],
      "@jack-tan/studio-core/*": ["../../packages/studio-core/src/*"],
      "jack-wave": ["../../apps/jack-wave/src/index.ts"],
      "jack-wave/*": ["../../apps/jack-wave/src/*"],
      "jack-pose": ["../../apps/jack-pose/src/index.ts"],
      "jack-pose/*": ["../../apps/jack-pose/src/*"],
      "jack-tan": ["../../apps/jack-tan/src/index.ts"],
      "jack-tan/*": ["../../apps/jack-tan/src/*"]
    }
  },
  "include": ["src"],
  "references": [
    { "path": "../../packages/studio-core" }
  ]
}
